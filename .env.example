# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Необязательное: период опроса цен, сек (по умолчанию 60)
#CHECK_INTERVAL_SEC=60

# Необязательное: файл настроек пользователей (по умолчанию data/users.json)
#DATA_FILE=data/users.json

# Необязательное: токен T-Invest API (ТОЛЬКО ЧТЕНИЕ) — стакан, лента сделок,
# сигналы о роботах. Без него эти функции просто выключены.
#TINKOFF_TOKEN=
# Необязательно: ID одного брокерского счёта для сверки доходности позиции.
# Без него позиции суммируются по всем открытым счетам.
#TINKOFF_ACCOUNT_ID=
# Частота обработки потоковых данных; REST при этом кэшируется.
#FLOW_INTERVAL_SEC=5

# Необязательное: канал для новостей (@username или -100…), бот должен быть админом
#NEWS_CHANNEL=
# Режим отбора: stocks (все бумаги РФ + рынок, по умолчанию) | watch (только мои)
#               | market (мои + рынок) | all (вообще всё)
#NEWS_MODE=stocks
# Период опроса источников, сек (по умолчанию 30)
#NEWS_INTERVAL_SEC=30

# --- мостик CScalp (опционально) ---
# CSCALP_KEY=длинная_случайная_строка   # тот же ключ в cscalp_bridge.ini на ПК
# OWNER_ID=123456789                    # ваш Telegram id: закрывает весь бот от посторонних
# CSCALP_RELAY=https://ntfy.sh          # релей команд (публичный URL боту не нужен)
# CSCALP_HTTP=1                         # альтернатива: бот сам слушает PORT (нужен публичный URL)

# --- скринер ---
# SCREENER_MIN_TURNOVER=50000000   # порог дневного оборота, ₽
# SCREENER_POLL_SEC=30

# --- окно сигналов ленты/стакана (МСК); вечерняя сессия по статистике — шум ---
# SIGNAL_FROM=07:00
# SIGNAL_TO=19:00
